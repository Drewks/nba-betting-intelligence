# ============================================================================
# NBA BETTING INTELLIGENCE - ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================
# No almacenes secretos ni credenciales reales dentro del repositorio.
# Copia este archivo a `.env` y completa únicamente las credenciales que poseas.
# El sistema opera en modo SIMULACIÓN (Paper Trading) con S/100.00 PEN virtuales.

# --- Proveedores de Datos Deportivos (Opcionales; ESPN Public API funciona sin clave) ---
SPORTRADAR_API_KEY=
SPORTRADAR_ACCESS_LEVEL=trial
SPORTRADAR_LANGUAGE=en

# --- Proveedores de Cuotas (Opcionales; ESPN/DraftKings public feed funciona sin clave) ---
THE_ODDS_API_KEY=
ODDS_DEFAULT_REGIONS=us
ODDS_DEFAULT_MARKETS=h2h,totals

# --- Configuración de NBA.com / Playwright ---
NBA_STATS_TIMEOUT_SECONDS=10
PLAYWRIGHT_HEADLESS=true

# --- Integración con PixelRAG (Si se instala un servidor local/MCP en el futuro) ---
PIXELRAG_ENABLED=false
PIXELRAG_ENDPOINT_URL=

# --- Almacenamiento y Obsidian ---
DATABASE_PATH=data/nba_intelligence.sqlite3
OBSIDIAN_VAULT_PATH=NBA

# --- Parámetros del Simulador (Paper Trading Exclusivo) ---
SIMULATION_ONLY=true
INITIAL_BANKROLL_PEN=100.00
BASE_STAKE_PEN=1.00
MAX_STAKE_PEN=1.00
MAX_SELECTIONS_PER_MATCHDAY=3
MIN_EV_THRESHOLD=0.05
RANDOM_SEED=42
