# ==============================================================================
# NBA Betting Intelligence - Plantilla de Variables de Entorno (.env.example)
# Copia este archivo como .env y coloca tus tokens reales.
# ==============================================================================

# 1. Telegram Alert Bot (V9 Fase 4)
# Token generado por @BotFather en Telegram (ej: 7123456789:AAH...):
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"

# Tu Chat ID numérico personal o del canal/grupo (ej: 987654321 o -1001234567890)
# Puedes obtenerlo enviando un mensaje a @userinfobot en Telegram:
TELEGRAM_CHAT_ID="987654321"

# 2. (Opcional) Proveedores externos de cuotas
ODDS_API_KEY=""
