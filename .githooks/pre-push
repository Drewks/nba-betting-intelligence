#!/bin/sh
# Guard: Block pushing commits that touch data/nba_intelligence.sqlite3
remote_name="$1"

is_zero_oid() {
    case "$1" in
        *[!0]*) return 1 ;;
        *) return 0 ;;
    esac
}

list_pushed_files() {
    l_oid="$1"
    r_oid="$2"

    if is_zero_oid "$r_oid" || ! git cat-file -e "${r_oid}^{commit}" 2>/dev/null; then
        if [ -n "$remote_name" ] && [ -n "$(git for-each-ref --count=1 "refs/remotes/$remote_name/" 2>/dev/null)" ]; then
            git log --format="" --name-only --no-renames -m "$l_oid" --not --remotes="$remote_name" 2>/dev/null
        else
            git log --format="" --name-only --no-renames -m "$l_oid" --not --remotes 2>/dev/null
        fi
    else
        git log --format="" --name-only --no-renames -m "$r_oid..$l_oid" 2>/dev/null
    fi
}

while read -r local_ref local_oid remote_ref remote_oid || [ -n "$local_oid" ]; do
    if is_zero_oid "$local_oid"; then
        continue
    fi

    if list_pushed_files "$local_oid" "$remote_oid" | grep -Fqx "data/nba_intelligence.sqlite3"; then
        {
            echo "======================================================================"
            echo "❌ ERROR: Push REJECTED by local branch guard!"
            echo "Your commits modify 'data/nba_intelligence.sqlite3'."
            echo "Direct binary database pushes corrupt historical audit records."
            echo "======================================================================"
        } >&2
        exit 1
    fi
done
exit 0
